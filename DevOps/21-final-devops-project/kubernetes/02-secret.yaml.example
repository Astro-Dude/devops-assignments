# EXAMPLE ONLY — this file is NOT applied and holds no real credential.
# Create the real Secret out-of-band so it never lands in git:
#
#   kubectl -n tickethub-raw create secret generic tickethub-db \
#     --from-literal=DB_USER=tickethub \
#     --from-literal=DB_PASSWORD="$(openssl rand -hex 16)"
#
# Production alternatives (see README "Secrets"): Sealed Secrets (encrypted SealedSecret
# committed to git, decrypted only in-cluster) or External Secrets Operator (Secret synced
# from AWS Secrets Manager / Vault).
apiVersion: v1
kind: Secret
metadata:
  name: tickethub-db
  namespace: tickethub-raw
type: Opaque
stringData:
  DB_USER: tickethub
  DB_PASSWORD: CHANGE_ME
