{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::astro-dude-s18-research",
        "arn:aws:s3:::astro-dude-s18-research/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "AllowAppRoleRead",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::123456789012:role/app-server-role" },
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::astro-dude-s18-research/reports/*"
    }
  ]
}
